{
  "name": "@local/dsh-model-rotation",
  "version": "0.2.11",
  "private": true,
  "description": "Model rotation chains: an ordered list of provider/model routes behind one picker entry, failing over on retryable errors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinRuidong-0323/dsh-model-rotation.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "failover",
    "model-rotation"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
